# Скопируй в .env (или задай эти переменные в панели хоста) и заполни

# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать: /id в боте)
ADMIN_IDS=
CHANNEL=@XazuraShop
SUPPORT_BOT=@XazuraSup_Bot
# Группа с гайдами и материалами
GROUP_LINK=https://t.me/XazuraMaterials
# Токен LOLZ (тот же, что в магазине): бот сам покупает аккаунты при обмене. Без него выдача вручную
LOLZ_TOKEN=
# Папка для базы и логов. На хосте укажи постоянный диск (volume), иначе база сотрётся при перезапуске
DATA_DIR=data
